# Ajouter au .env du VPS OliveApps (ne pas coller les secrets Dibidani / ERDV).
# openssl rand -base64 48

COUTURIX_TAG=latest
COUTURIX_FRONTEND_TAG=latest
COUTURIX_BACKEND_TAG=latest
COUTURIX_HOST=couturix.com
COUTURIX_HOST_WWW=www.couturix.com

COUTURIX_UPLOAD_HOST_PATH=./uploads/couturix
COUTURIX_BACKUP_HOST_PATH=./backup/couturix

COUTURIX_DB=couturix
COUTURIX_DB_USER=couturix
COUTURIX_DB_PASS=change_me_strong_password

# Compte SUPER_ADMIN, resynchronisé à chaque redémarrage du backend.
# Si le mot de passe contient # $ ! * espaces, l’entourer de simples quotes.
COUTURIX_ADMIN_EMAIL=admin@couturix.com
COUTURIX_ADMIN_PASSWORD=change_me_strong_admin_password

# Minimum 32 octets.
COUTURIX_JWT_SECRET=replace_with_at_least_32_random_bytes

COUTURIX_MAIL_HOST=smtp.gmail.com
COUTURIX_MAIL_PORT=587
COUTURIX_MAIL_FROM=
# MAIL_USERNAME / MAIL_PASSWORD = SMTP_USER / SMTP_PASSWORD déjà présents

COUTURIX_WHATSAPP_ENABLED=false
COUTURIX_STOCK_ALLOW_NEGATIVE=false

# SMS Gateway (Android SimpApp). Reprend SMS_GATEWAY_* du VPS si déjà défini.
# COUTURIX_SMS_GATEWAY_ENABLED=true
# COUTURIX_SMS_GATEWAY_API_KEY=
# COUTURIX_SMS_GATEWAY_URL=
